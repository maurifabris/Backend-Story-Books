<div id="google-auth-warning" class="modal">
    <div class="modal-content">
        <h4>¡Atención!</h4>
        <p>"Esta es una versión para portafolio. Por lo que Google no permite usar OAuth. Puede probar con la cuenta
            Email: prueba@gmail.com Contraseña: 123
            O creando un nuevo usuario
            Para probar OAuth, clone el proyecto de <a href="https://github.com/maurifabris/Backend-Story-Books.git" target="_blank" rel="noopener noreferrer">GitHub</a> y ejecútalo localmente."</p>
    </div>
</div>
<div class="container center-align" style="margin-top: 100px;">
  <h3>
    <i class="fas fa-book-reader"></i> StoryBooks
  </h3>

  <p class="flow-text">Create public or private stories</p>

  <div class="row">
    <div class="col s12 m6 offset-m3">
      <!-- Botón Google -->
      <a href="/auth/google" class="btn red darken-1 waves-effect waves-light" style="margin-bottom: 15px; width: 100%;">
        <i class="fab fa-google left"></i>
        Login with Google
      </a>
      
      <!-- Botón Registro -->
      <a href="/auth/register" class="btn blue darken-1 waves-effect waves-light" style="margin-bottom: 15px; width: 100%;">
        <i class="fas fa-user-plus left"></i>
        register without google
      </a>
      
      <!-- Botón Login -->
      <a href="/auth/login" class="btn grey darken-3 waves-effect waves-light" style="width: 100%;">
        <i class="fas fa-sign-in-alt left"></i>
        Login
      </a>
    </div>
  </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modalElem = document.querySelector('#google-auth-warning');
        const instance = M.Modal.init(modalElem, {
            dismissible: true // se cierra al hacer clic afuera
        });
        instance.open();
    });
</script>