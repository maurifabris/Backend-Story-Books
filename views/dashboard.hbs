<div class="container">
    <div class="section">
        <div class="card-panel teal lighten-5 z-depth-1">
            <h5 class="teal-text text-darken-4">📚 Dashboard</h5>
            <h4 class="header">Welcome, {{name}}</h4>
            <p class="grey-text text-darken-1">Here are your stories:</p>
        </div>

        {{#if stories}}
        <div class="row">
            {{#each stories}}
            <div class="col s12 m6 l4">
                <div class="story-card card">
                    <div class="card-content">
                        <span class="card-title truncate">
                            <a href="/stories/{{_id}}" class="teal-text text-darken-2">{{title}}</a>
                        </span>
                        <div class="story-content">
                            <p><strong>Date:</strong> {{formatDate createdAT 'MMMM Do YYYY, h:mm a'}}</p>
                            <p><strong>Status:</strong> 
                                <span class="new badge {{#if (eq status 'public')}}green{{else}}grey{{/if}}">
                                    {{status}}
                                </span>
                            </p>
                        </div>
                    </div>
                    <div class="card-action center-align">
                        <!-- Botones -->
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
        {{else}}
        <div class="card-panel grey lighten-4">
            <p class="grey-text text-darken-1">You have not created any stories yet.</p>
        </div>
        {{/if}}
    </div>
</div>